# Caminho do banco de dados SQLite (padrao: app.db na raiz)
DB_PATH=E:\controle-impressoras\app.db

# Chave secreta para sessoes/tokens (altere em producao!)
SECRET_KEY=minha-chave-super-secreta

# Modo debug (true/false)
DEBUG=false

# NOTIFICACOES
# Configure em: Configuracoes > Notificacoes de Alertas
# Os dados de SMTP serao salvos em notification_config.json
